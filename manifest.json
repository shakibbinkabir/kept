{
  "manifest_version": 3,
  "name": "Kept: Instagram chat & post backup",
  "short_name": "Kept",
  "version": "4.6.0",
  "description": "Keep Instagram chats with their photos and voice notes, and posts, reels, stories and highlights, on your own computer.",
  "permissions": [
    "activeTab",
    "scripting",
    "downloads",
    "downloads.open",
    "offscreen",
    "storage"
  ],
  "host_permissions": [
    "https://www.instagram.com/*",
    "https://i.instagram.com/*",
    "https://*.cdninstagram.com/*",
    "https://*.fbcdn.net/*",
    "https://*.fbsbx.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://www.instagram.com/*"],
      "js": ["src/queryvars.js", "src/bridge.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.instagram.com/*"],
      "js": ["src/pageids.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/normalizer.js",
        "src/schema.js"
      ],
      "matches": ["https://www.instagram.com/*"]
    }
  ]
}
